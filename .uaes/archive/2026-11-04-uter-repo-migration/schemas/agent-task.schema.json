{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/agent-task.schema.json",
  "title": "UAES Agent Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "runId",
    "type",
    "objective",
    "scope",
    "constraints",
    "acceptanceCriteria",
    "status",
    "authorization",
    "budget"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "parentTaskId": {
      "type": ["string", "null"]
    },
    "type": {
      "enum": [
        "question",
        "research",
        "documentation",
        "design",
        "implementation",
        "debugging",
        "code-review",
        "testing",
        "security-audit",
        "refactoring",
        "release",
        "maintenance"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded"
      ],
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "status": {
      "enum": [
        "created",
        "planned",
        "ready",
        "running",
        "waiting-approval",
        "paused",
        "completed",
        "partially-completed",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "assignedAgents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "relation"
        ],
        "properties": {
          "taskId": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "blocks",
              "depends-on",
              "related-to",
              "conflicts-with",
              "validates",
              "replaces"
            ]
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "allowedActions",
        "deniedActions"
      ],
      "properties": {
        "reference": {
          "type": "string"
        },
        "allowedActions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deniedActions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approvalRequired": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSteps",
        "maxToolCalls",
        "maxRetries"
      ],
      "properties": {
        "maxSteps": {
          "type": "integer",
          "minimum": 1
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 1
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxParallelAgents": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
