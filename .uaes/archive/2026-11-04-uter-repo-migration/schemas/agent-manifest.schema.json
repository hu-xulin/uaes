{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/agent-manifest.schema.json",
  "title": "UAES Agent Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "agentId",
    "name",
    "version",
    "role",
    "status",
    "responsibilities",
    "tools",
    "permissionProfile",
    "runtime",
    "evaluation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "agentId": {
      "type": "string",
      "pattern": "^uter\\.agent\\.[a-z0-9.-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "inactive",
        "deprecated",
        "experimental"
      ]
    },
    "responsibilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "nonResponsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "permissionProfile": {
      "type": "string"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "isolation"
      ],
      "properties": {
        "environment": {
          "enum": [
            "local",
            "cloud",
            "container",
            "vm",
            "ide",
            "managed"
          ]
        },
        "isolation": {
          "enum": [
            "required",
            "preferred",
            "not-required"
          ]
        },
        "networkPolicy": {
          "enum": [
            "disabled",
            "allowlist",
            "restricted",
            "unrestricted"
          ]
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "profile"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "profile": {
          "type": "string"
        },
        "datasetVersion": {
          "type": ["string", "null"]
        }
      }
    },
    "owner": {
      "type": "string"
    }
  }
}
