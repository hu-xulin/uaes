{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/security-incident.schema.json",
  "title": "UAES Security Incident",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "title",
    "severity",
    "status",
    "detected_at",
    "incident_owner",
    "affected_assets",
    "timeline"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "pattern": "^INC-SEC-[0-9]{4,}$"
    },
    "title": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "SEV-1",
        "SEV-2",
        "SEV-3",
        "SEV-4"
      ]
    },
    "status": {
      "enum": [
        "DETECTED",
        "TRIAGED",
        "CONTAINING",
        "INVESTIGATING",
        "ERADICATING",
        "RECOVERING",
        "VERIFYING",
        "CLOSED"
      ]
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "incident_owner": {
      "type": "string"
    },
    "affected_assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "impact_summary": {
      "type": "string"
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "event"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "event": {
            "type": "string"
          },
          "actor": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "containment_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "root_cause": {
      "type": [
        "string",
        "null"
      ]
    },
    "recovery_verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "postmortem_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
