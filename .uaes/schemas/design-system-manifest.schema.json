{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.cc/uaes/schemas/design-system-manifest.schema.json",
  "title": "UAES Design System Manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "status",
    "token_source",
    "themes",
    "platforms",
    "owners"
  ],
  "properties": {
    "id": {
      "const": "UTER-DESIGN-SYSTEM"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "deprecated"
      ]
    },
    "token_source": {
      "type": "string",
      "minLength": 1
    },
    "token_specification": {
      "type": "string"
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "web",
          "h5",
          "electron",
          "android",
          "ios",
          "harmonyos"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "owners": {
      "type": "object",
      "required": ["design", "engineering"],
      "properties": {
        "design": { "type": "string" },
        "engineering": { "type": "string" },
        "accessibility": { "type": "string" }
      },
      "additionalProperties": false
    },
    "source_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "status": {
            "enum": [
              "pending_review",
              "approved",
              "deprecated"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
