{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/report.schema.json",
  "title": "UAES Engineering Report",
  "type": "object",
  "required": [
    "reportId",
    "reportType",
    "createdAt",
    "status",
    "summary",
    "evidence"
  ],
  "properties": {
    "reportId": {
      "type": "string",
      "minLength": 1
    },
    "reportType": {
      "enum": [
        "COMPLIANCE",
        "QUALITY",
        "SECURITY",
        "ARCHITECTURE",
        "RELEASE",
        "INCIDENT",
        "ACCEPTANCE"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "PARTIAL",
        "NOT_RUN"
      ]
    },
    "repository": {
      "type": "string"
    },
    "baselineCommit": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "NOT_APPLICABLE",
              "NOT_VERIFIED"
            ]
          },
          "command": {
            "type": "string"
          },
          "exitCode": {
            "type": "integer"
          },
          "reference": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
