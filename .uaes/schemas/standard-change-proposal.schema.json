{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/standard-change-proposal.schema.json",
  "title": "UAES Standard Change Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "proposalId",
    "title",
    "reason",
    "proposer",
    "affectedStandards",
    "changeType",
    "impact",
    "status",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "proposalId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "proposer": {
      "type": "string"
    },
    "affectedStandards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^UAES-[0-9]{2}(-[0-9]{3})?$"
      },
      "uniqueItems": true
    },
    "changeType": {
      "enum": [
        "clarification",
        "addition",
        "modification",
        "removal",
        "version_upgrade",
        "schema_change",
        "gate_change",
        "emergency"
      ]
    },
    "impact": {
      "type": "object",
      "required": [
        "compatibility",
        "implementation",
        "automation",
        "governance"
      ],
      "properties": {
        "compatibility": {
          "enum": ["none", "low", "medium", "high", "breaking", "unknown"]
        },
        "implementation": {
          "enum": ["none", "low", "medium", "high", "unknown"]
        },
        "automation": {
          "enum": ["none", "low", "medium", "high", "unknown"]
        },
        "governance": {
          "enum": ["none", "low", "medium", "high", "unknown"]
        }
      },
      "additionalProperties": false
    },
    "schemaChanges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gateChanges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "migrationPlanRef": {
      "type": ["string", "null"]
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "needs_revision",
        "approved",
        "rejected",
        "implemented",
        "verified",
        "closed"
      ]
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["approver", "decision", "timestamp"],
        "properties": {
          "approver": {
            "type": "string"
          },
          "decision": {
            "enum": ["approved", "rejected", "needs_revision"]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "effectiveAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
