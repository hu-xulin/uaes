{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/agent-authorization.schema.json",
  "title": "UAES Agent Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_id",
    "task_id",
    "subject",
    "actions",
    "resources",
    "environment",
    "risk_level",
    "decision",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "authorization_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_authorization_id": {
      "type": ["string", "null"]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "role"],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "READ",
          "SEARCH",
          "CREATE",
          "UPDATE",
          "DELETE",
          "EXECUTE",
          "COMMIT",
          "PUSH",
          "PR_CREATE",
          "PR_MERGE",
          "DEPLOY",
          "DB_WRITE",
          "SECRET_READ",
          "CONFIG_CHANGE"
        ]
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "environment": {
      "enum": [
        "LOCAL_SANDBOX",
        "DEVELOPMENT",
        "TEST",
        "STAGING",
        "PRODUCTION"
      ]
    },
    "risk_level": {
      "enum": ["R0", "R1", "R2", "R3", "R4"]
    },
    "decision": {
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_APPROVAL",
        "OUT_OF_SCOPE"
      ]
    },
    "approval": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["approval_id", "approver", "approved_at"],
      "properties": {
        "approval_id": {
          "type": "string"
        },
        "approver": {
          "type": "string"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
