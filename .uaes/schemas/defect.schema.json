{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/defect.schema.json",
  "title": "UAES Defect",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "defect_id",
    "title",
    "description",
    "severity",
    "priority",
    "status",
    "reported_at",
    "owner"
  ],
  "properties": {
    "defect_id": {
      "type": "string",
      "pattern": "^DEF-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFORMATIONAL"
      ]
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "status": {
      "enum": [
        "REPORTED",
        "TRIAGED",
        "CONFIRMED",
        "ASSIGNED",
        "FIX_IN_PROGRESS",
        "FIXED",
        "VERIFYING",
        "VERIFIED",
        "CLOSED",
        "NEEDS_INFORMATION",
        "DUPLICATE",
        "REJECTED",
        "DEFERRED",
        "REOPENED"
      ]
    },
    "task_id": {
      "type": ["string", "null"]
    },
    "finding_id": {
      "type": ["string", "null"]
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "repository": {
      "type": ["string", "null"]
    },
    "base_commit_sha": {
      "type": ["string", "null"]
    },
    "fixed_commit_sha": {
      "type": ["string", "null"]
    },
    "affected_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reproduction_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_result": {
      "type": ["string", "null"]
    },
    "actual_result": {
      "type": ["string", "null"]
    },
    "root_cause": {
      "type": ["string", "null"]
    },
    "fix_description": {
      "type": ["string", "null"]
    },
    "regression_test_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "reported_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "closed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "deferred_until": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
