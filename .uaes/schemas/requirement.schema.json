
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/requirement.schema.json",
  "title": "UAES Requirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "type",
    "priority",
    "status",
    "objective",
    "acceptance_criteria"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REQ-[0-9]{4,}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "type": {
      "enum": [
        "FR",
        "NFR",
        "BRQ",
        "UX",
        "TR",
        "SR",
        "CR",
        "CPR"
      ]
    },
    "priority": {
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "status": {
      "enum": [
        "INTAKE",
        "ANALYZING",
        "CLARIFICATION_REQUIRED",
        "PROPOSED",
        "APPROVED",
        "PLANNED",
        "IN_PROGRESS",
        "IMPLEMENTED",
        "VERIFYING",
        "ACCEPTED",
        "REJECTED",
        "DEFERRED",
        "DEPRECATED"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "background": {
      "type": "string"
    },
    "business_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^BR-[0-9]{4,}$"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^AC-[0-9]{4,}$"
      }
    },
    "risk_level": {
      "enum": ["R0", "R1", "R2", "R3", "R4"]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement", "status"],
        "properties": {
          "statement": {
            "type": "string"
          },
          "status": {
            "enum": [
              "UNCONFIRMED",
              "CONFIRMED",
              "REJECTED"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
