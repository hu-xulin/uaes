{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/delivery-evidence.schema.json",
  "title": "UAES Delivery Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "taskId",
    "sourceCommitSha",
    "changeSummary",
    "quality",
    "security",
    "deliveryStatus",
    "actor",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "evidenceId": { "type": "string" },
    "taskId": { "type": "string" },
    "sourceCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "pullRequest": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "status": { "enum": ["open", "approved", "merged", "closed", "unknown"] }
      },
      "required": ["id", "status"],
      "additionalProperties": false
    },
    "changeSummary": { "type": "string", "minLength": 1 },
    "changedFiles": { "type": "array", "items": { "type": "string" } },
    "quality": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pass", "fail", "blocked", "not_run", "not_verified"] },
        "gateRefs": { "type": "array", "items": { "type": "string" } },
        "testEvidenceRefs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pass", "fail", "blocked", "not_run", "not_verified"] },
        "scanEvidenceRefs": { "type": "array", "items": { "type": "string" } },
        "sbomRef": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "digest"],
        "properties": {
          "name": { "type": "string" },
          "digest": { "type": "string" },
          "provenanceRef": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "deliveryStatus": {
      "enum": ["not_started", "in_progress", "blocked", "failed", "succeeded", "not_verified"]
    },
    "actor": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["human", "agent", "system"] },
        "id": { "type": "string" },
        "authorizationId": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
