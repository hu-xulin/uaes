{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/deprecation-plan.schema.json",
  "title": "UAES Deprecation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deprecationId",
    "assetId",
    "reason",
    "owner",
    "affectedConsumers",
    "status",
    "proposedAt",
    "migrationPlan",
    "exitCriteria"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "deprecationId": {
      "type": "string"
    },
    "assetId": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "affectedConsumers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["consumerId", "migrationStatus"],
        "properties": {
          "consumerId": {
            "type": "string"
          },
          "migrationStatus": {
            "enum": [
              "unknown",
              "not_started",
              "in_progress",
              "completed",
              "waived",
              "blocked"
            ]
          },
          "evidenceRef": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "replacementAssetId": {
      "type": ["string", "null"]
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "deprecated",
        "migration_period",
        "sunset_ready",
        "removed",
        "cancelled",
        "blocked"
      ]
    },
    "proposedAt": {
      "type": "string",
      "format": "date-time"
    },
    "effectiveAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "sunsetAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "migrationPlan": {
      "type": "object",
      "required": ["steps", "verification"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "rollbackRef": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "exitCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "approvalRef": {
      "type": ["string", "null"]
    },
    "finalEvidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
