{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/task.schema.json",
  "title": "UAES Engineering Task Contract",
  "type": "object",
  "required": [
    "taskId",
    "title",
    "request",
    "repository",
    "baselineCommit",
    "scope",
    "taskType",
    "riskLevel",
    "authorization",
    "acceptanceCriteria",
    "verificationPlan"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "baselineCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "nonGoals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "taskType": {
      "enum": [
        "FEATURE",
        "BUGFIX",
        "REFACTOR",
        "REVIEW",
        "TEST",
        "SECURITY",
        "DOCUMENTATION",
        "RELEASE",
        "INCIDENT",
        "INTEGRATION"
      ]
    },
    "riskLevel": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "authorization": {
      "type": "object",
      "required": [
        "allowedActions",
        "prohibitedActions"
      ],
      "properties": {
        "allowedActions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prohibitedActions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approvalRequired": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "verificationPlan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "method"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "standardRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "delivery": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string"
        },
        "commitAllowed": {
          "type": "boolean"
        },
        "pushAllowed": {
          "type": "boolean"
        },
        "pullRequestAllowed": {
          "type": "boolean"
        },
        "mergeAllowed": {
          "type": "boolean"
        },
        "deployAllowed": {
          "type": "boolean"
        },
        "format": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "requestSource": {
      "type": "string",
      "minLength": 1
    },
    "intendedOutcome": {
      "type": "string",
      "minLength": 1
    },
    "dataClassification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED",
        "REGULATED"
      ]
    },
    "requiredInputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approvalPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "approverRole"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "approverRole": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "expectedEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
