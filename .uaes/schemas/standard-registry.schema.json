{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/standard-registry.schema.json",
  "title": "UAES Standard Registry",
  "description": "Reconstructed (provenance: RECONSTRUCTED, status: DRAFT) machine-readable contract for .uaes/STANDARD-REGISTRY.yaml. Validates the global registry identity, phase map, entry lists and dependency records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry",
    "phases",
    "standards",
    "schemas",
    "gates",
    "acceptance",
    "exceptions",
    "dependencies",
    "history"
  ],
  "properties": {
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "abbreviation",
        "version",
        "schema_version",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "abbreviation": {
          "type": "string",
          "minLength": 2
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "status": {
          "$ref": "#/$defs/lifecycleStatus"
        },
        "project": {
          "type": "object"
        },
        "governance": {
          "type": "object"
        },
        "lifecycle_status": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requirement_levels": {
          "type": "array",
          "items": {
            "enum": [
              "MUST",
              "MUST_NOT",
              "SHOULD",
              "SHOULD_NOT",
              "MAY"
            ]
          }
        },
        "priority_levels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "historical": {
              "type": "string"
            },
            "reconstructed": {
              "type": "string"
            },
            "new": {
              "type": "string"
            }
          },
          "required": [
            "historical",
            "reconstructed",
            "new"
          ],
          "additionalProperties": false
        }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/phase"
      }
    },
    "standards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "schemas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "system_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "tool_adapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "validation": {
      "type": "object"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/historyRecord"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exceptionRecord"
      }
    }
  },
  "$defs": {
    "lifecycleStatus": {
      "enum": [
        "PROPOSED",
        "DRAFT",
        "IN_REVIEW",
        "NEEDS_REVISION",
        "APPROVED",
        "IMPLEMENTED",
        "VERIFIED",
        "ACTIVE",
        "REJECTED",
        "DEPRECATED",
        "SUPERSEDED",
        "RETIRED"
      ]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3
        },
        "description": {
          "type": "string",
          "minLength": 3
        },
        "status": {
          "$ref": "#/$defs/lifecycleStatus"
        },
        "provenance": {
          "type": "string"
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval": {
          "$ref": "#/$defs/approvalRecord"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^UAES-[A-Z0-9]+(-[A-Z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "file": {
          "type": "string",
          "minLength": 3
        },
        "type": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/lifecycleStatus"
        },
        "priority": {
          "type": "string"
        },
        "provenance": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "approval": {
          "$ref": "#/$defs/approvalRecord"
        },
        "shared_with": {
          "type": "string",
          "pattern": "^UAES-SCHEMA-[0-9]{2}-[0-9]{3}$"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard",
        "depends_on"
      ],
      "properties": {
        "standard": {
          "type": "string",
          "pattern": "^UAES-[A-Z0-9]+(-[A-Z0-9]+)*$"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^UAES-[A-Z0-9]+(-[A-Z0-9]+)*$"
          }
        },
        "forward_depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^UAES-[A-Z0-9]+(-[A-Z0-9]+)*$"
          }
        },
        "coordination": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "historyRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "date",
        "change"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "change": {
          "type": "string",
          "minLength": 3
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "exceptionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "related_rule_ids",
        "status",
        "requester",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^UAES-EXC-[0-9]{4,}$"
        },
        "related_rule_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "REQUESTED",
            "RISK_ASSESSED",
            "IN_REVIEW",
            "NEEDS_REVISION",
            "APPROVED",
            "ACTIVE",
            "REJECTED",
            "EXPIRED",
            "REVOKED",
            "CLOSED"
          ]
        },
        "requester": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "business_justification": {
          "type": "string"
        },
        "risk_assessment": {
          "type": "string"
        },
        "compensating_controls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "approver": {
          "type": "string"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "approval_evidence": {
          "type": "string"
        },
        "rollback_plan": {
          "type": "string"
        },
        "verification_plan": {
          "type": "string"
        },
        "pull_request": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "APPROVED",
                  "ACTIVE"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "approver",
              "approved_at",
              "approval_evidence",
              "expires_at",
              "risk_assessment",
              "compensating_controls",
              "rollback_plan",
              "verification_plan"
            ]
          }
        }
      ]
    },
    "approvalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approver",
        "approved_at",
        "evidence",
        "change_request"
      ],
      "properties": {
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "change_request": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
