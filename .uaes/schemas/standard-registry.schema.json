{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/standard-registry.schema.json",
  "title": "UAES Standard Registry",
  "description": "Reconstructed (provenance: RECONSTRUCTED, status: DRAFT) machine-readable contract for .uaes/STANDARD-REGISTRY.yaml. Validates the global registry identity, phase map, entry lists and dependency records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry",
    "phases",
    "standards",
    "schemas",
    "gates",
    "acceptance",
    "dependencies",
    "history"
  ],
  "properties": {
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "abbreviation",
        "version",
        "schema_version",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 3 },
        "abbreviation": { "type": "string", "minLength": 2 },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "status": { "$ref": "#/$defs/lifecycleStatus" },
        "project": { "type": "object" },
        "governance": { "type": "object" },
        "lifecycle_status": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requirement_levels": {
          "type": "array",
          "items": { "enum": ["MUST", "MUST_NOT", "SHOULD", "SHOULD_NOT", "MAY"] }
        }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/phase" }
    },
    "standards": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "schemas": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "gates": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "acceptance": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "system_files": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "tool_adapters": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "validation": { "type": "object" },
    "history": {
      "type": "array",
      "items": { "$ref": "#/$defs/historyRecord" }
    }
  },
  "$defs": {
    "lifecycleStatus": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "IN_REVIEW",
        "APPROVED",
        "IMPLEMENTED",
        "VERIFIED",
        "DEPRECATED",
        "SUPERSEDED"
      ]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "status"],
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "description": { "type": "string", "minLength": 3 },
        "status": { "$ref": "#/$defs/lifecycleStatus" },
        "provenance": { "type": "string" },
        "deliverables": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^UAES-[A-Z0-9]+(-[A-Z0-9]+)*$"
        },
        "name": { "type": "string" },
        "file": { "type": "string", "minLength": 3 },
        "type": { "type": "string" },
        "phase": { "type": "string" },
        "status": { "$ref": "#/$defs/lifecycleStatus" },
        "priority": { "type": "string" },
        "provenance": { "type": "string" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "depends_on"],
      "properties": {
        "standard": {
          "type": "string",
          "pattern": "^UAES-[A-Z0-9]+(-[A-Z0-9]+)*$"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^UAES-[A-Z0-9]+(-[A-Z0-9]+)*$"
          }
        },
        "forward_depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^UAES-[A-Z0-9]+(-[A-Z0-9]+)*$"
          }
        }
      }
    },
    "historyRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "date", "change"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "change": { "type": "string", "minLength": 3 },
        "scope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
