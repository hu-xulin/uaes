
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/business-rule.schema.json",
  "title": "UAES Business Rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "domain",
    "status",
    "statement",
    "applies_to",
    "behavior"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^BR-[0-9]{4,}$"
    },
    "title": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "APPROVED",
        "ACTIVE",
        "DEPRECATED",
        "SUPERSEDED"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "behavior": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^REQ-[0-9]{4,}$"
      }
    },
    "owner": {
      "type": "string"
    },
    "source": {
      "type": "string"
    }
  }
}
