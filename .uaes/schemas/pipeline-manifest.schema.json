{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/pipeline-manifest.schema.json",
  "title": "UAES Pipeline Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pipelineId",
    "repository",
    "source",
    "trigger",
    "workflow",
    "jobs",
    "permissions",
    "qualityGates",
    "status"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "pipelineId": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "object",
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "format": "uri" },
        "visibility": { "enum": ["public", "private", "internal", "unknown"] }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["commitSha", "ref"],
      "properties": {
        "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "ref": { "type": "string", "minLength": 1 },
        "pullRequestId": { "type": ["string", "null"] },
        "baseSha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$" }
      },
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "required": ["event", "actor", "timestamp"],
      "properties": {
        "event": {
          "enum": ["push", "pull_request", "workflow_dispatch", "schedule", "release", "deployment", "other"]
        },
        "actor": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "workflowCommitSha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$" }
      },
      "additionalProperties": false
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["jobId", "name", "status"],
        "properties": {
          "jobId": { "type": "string" },
          "name": { "type": "string" },
          "status": {
            "enum": ["queued", "running", "success", "failure", "cancelled", "skipped", "not_run"]
          },
          "startedAt": { "type": ["string", "null"], "format": "date-time" },
          "completedAt": { "type": ["string", "null"], "format": "date-time" },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "permissions": {
      "type": "object",
      "required": ["defaultLevel", "elevatedPermissions"],
      "properties": {
        "defaultLevel": { "enum": ["read_only", "restricted", "custom"] },
        "elevatedPermissions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "qualityGates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gateId", "status"],
        "properties": {
          "gateId": { "type": "string" },
          "status": {
            "enum": ["pass", "fail", "blocked", "not_run", "not_applicable", "not_verified"]
          },
          "evidenceRef": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "artifactDigests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "algorithm", "digest"],
        "properties": {
          "name": { "type": "string" },
          "algorithm": { "enum": ["sha256", "sha384", "sha512"] },
          "digest": { "type": "string", "pattern": "^[a-f0-9]+$" }
        },
        "additionalProperties": false
      }
    },
    "provenanceRef": { "type": ["string", "null"] },
    "status": {
      "enum": ["queued", "running", "success", "failure", "cancelled", "blocked", "not_verified"]
    }
  }
}
