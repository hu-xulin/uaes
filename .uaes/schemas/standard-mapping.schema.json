{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/standard-mapping.schema.json",
  "title": "UAES Standard-to-Code Mapping",
  "type": "object",
  "required": [
    "version",
    "mappings",
    "verification_catalog"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "modules",
          "rules",
          "verification",
          "gate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MAP-[A-Z0-9-]+$"
          },
          "domain": {
            "type": "string",
            "pattern": "^UAES-[0-9]{2}$"
          },
          "modules": {
            "type": [
              "array",
              "string"
            ]
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^UAES-[0-9]{2}-[0-9]{3}-[0-9]{3}$"
            }
          },
          "rule_level_status": {
            "enum": [
              "REGISTERED",
              "NO_RULE_IDS_REGISTERED_IN_DOMAIN"
            ]
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gate": {
            "type": "string",
            "pattern": "^UAES-[0-9]{2}-GATE-[0-9]{3}$"
          }
        }
      }
    },
    "verification_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "command",
          "declared_in",
          "execution"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "command",
              "npm-script",
              "script",
              "manual-review"
            ]
          },
          "command": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "declared_in": {
            "type": "string"
          },
          "execution": {
            "enum": [
              "DELEGATED_TO_EXISTING_TOOL",
              "MANUAL",
              "GOVERNANCE_NATIVE"
            ]
          }
        }
      }
    }
  }
}
