{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/security-assessment.schema.json",
  "title": "UAES Security Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "scope",
    "commit_sha",
    "environment",
    "started_at",
    "status",
    "checks"
  ],
  "properties": {
    "assessment_id": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commit_sha": {
      "type": "string"
    },
    "environment": {
      "enum": [
        "LOCAL",
        "CI",
        "TEST",
        "STAGING",
        "PRODUCTION"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "NOT_VERIFIED"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "tool",
          "status"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "tool_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "findings_count": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "vulnerability_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sbom_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
