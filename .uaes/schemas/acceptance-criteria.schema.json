
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/acceptance-criteria.schema.json",
  "title": "UAES Acceptance Criteria",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "requirement_id",
    "description",
    "verification_method",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^AC-[0-9]{4,}$"
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^REQ-[0-9]{4,}$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_result": {
      "type": "string",
      "minLength": 1
    },
    "verification_method": {
      "enum": [
        "UNIT",
        "INTEGRATION",
        "E2E",
        "API",
        "UI",
        "SECURITY",
        "PERFORMANCE",
        "MANUAL"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "NOT_APPLICABLE",
        "NOT_VERIFIED"
      ]
    }
  }
}
