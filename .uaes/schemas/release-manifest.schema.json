{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uter.ai/uaes/schemas/release-manifest.schema.json",
  "title": "UAES Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "version",
    "releaseType",
    "sourceCommitSha",
    "artifacts",
    "qualityGateStatus",
    "securityGateStatus",
    "approvalStatus",
    "status"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "releaseId": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "releaseType": { "enum": ["stable", "prerelease", "hotfix", "internal"] },
    "sourceCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "tag": { "type": ["string", "null"] },
    "releaseNotesRef": { "type": ["string", "null"] },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "uri", "digestAlgorithm", "digest"],
        "properties": {
          "name": { "type": "string" },
          "uri": { "type": "string", "format": "uri" },
          "digestAlgorithm": { "enum": ["sha256", "sha384", "sha512"] },
          "digest": { "type": "string", "pattern": "^[a-f0-9]+$" },
          "provenanceRef": { "type": ["string", "null"] },
          "sbomRef": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "qualityGateStatus": {
      "enum": ["pass", "fail", "blocked", "not_run", "not_verified"]
    },
    "securityGateStatus": {
      "enum": ["pass", "fail", "blocked", "not_run", "not_verified"]
    },
    "approvalStatus": {
      "enum": ["pending", "approved", "rejected", "not_required", "not_verified"]
    },
    "approvedBy": { "type": ["string", "null"] },
    "approvedAt": { "type": ["string", "null"], "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "status": {
      "enum": ["draft", "candidate", "approved", "published", "withdrawn", "blocked"]
    }
  }
}
