#!/usr/bin/env ruby
require "json"
require "open3"
require "rbconfig"
require "tempfile"

def stop(message, code = 2)
  warn "ROUTER OPENAPI DRIFT: #{message}"
  exit code
end

def gin_path_covers_openapi?(gin_path, openapi_path)
  gin_segments = gin_path.split("/").reject(&:empty?)
  api_segments = openapi_path.split("/").reject(&:empty?)
  index = 0

  while index < gin_segments.length
    segment = gin_segments[index]
    return index < api_segments.length if segment.start_with?("*")
    return false if index >= api_segments.length

    dynamic = segment.start_with?(":")
    api_dynamic = api_segments[index].match?(/\A\{[^{}]+\}(?::.*)?\z/)

    # A Gin parameter can serve a concrete or parameterized OpenAPI segment.
    # A static Gin segment cannot serve an OpenAPI parameter: it would only
    # match one literal value and would overstate runtime route coverage.
    return false unless dynamic || (!api_dynamic && segment == api_segments[index])

    index += 1
  end

  index == api_segments.length
end

def operation_covered?(routes, method, path)
  routes.any? do |route|
    route["method"] == method && gin_path_covers_openapi?(route["path"], path)
  end
end

root = ENV["UTER_REPO_ROOT"]
stop("UTER_REPO_ROOT is required") if root.nil? || root.empty?
root = File.expand_path(root)
stop("Uter source checkout missing") unless File.directory?(root)

documents = %w[docs-dev/openapi/api.json docs-dev/openapi/relay.json]
documents.each { |path| stop("OpenAPI document missing: #{path}") unless File.file?(File.join(root, path)) }

inventory_json = ENV["UAES_ROUTE_INVENTORY_JSON"]
if inventory_json && !inventory_json.empty?
  stop("route inventory fixture missing") unless File.file?(inventory_json)
  routes = JSON.parse(File.read(inventory_json))
else
  router_dir = File.join(root, "router")
  stop("router source directory missing") unless File.directory?(router_dir)
  test_path = File.join(router_dir, "uaes_route_inventory_test.go")
  stop("refusing to overwrite existing #{test_path}") if File.exist?(test_path)
  output = Tempfile.new(["uaes-gin-routes-", ".json"])
  output.close
  go_test = <<~GO
    package router

    import (
      "encoding/json"
      "os"
      "testing"

      "github.com/gin-gonic/gin"
      "github.com/uter-ai/uter/pkg/jsplugin"
    )

    func TestUAESRouteInventory(t *testing.T) {
      gin.SetMode(gin.ReleaseMode)
      engine := gin.New()
      SetApiRouter(engine)
      SetDashboardRouter(engine)
      SetRelayRouter(engine)
      SetTaskPluginProtocolRouter(engine)
      SetVideoRouter(engine)
      SetTaskRouter(engine)

      routes := engine.Routes()
      records := make([]map[string]string, 0, len(routes))
      for _, route := range routes {
        records = append(records, map[string]string{"method": route.Method, "path": route.Path, "source": "gin"})
      }
      generation := jsplugin.DefaultRegistry.Generation()
      if generation == nil {
        t.Fatal("built-in task plugin routing generation is unavailable")
      }
      pluginRoutes := generation.Routes()
      for _, binding := range pluginRoutes {
        records = append(records, map[string]string{"method": binding.Route.Method, "path": binding.Route.Path, "source": "plugin"})
      }
      target := os.Getenv("UAES_ROUTE_INVENTORY_OUTPUT")
      if target == "" {
        t.Fatal("UAES_ROUTE_INVENTORY_OUTPUT is required")
      }
      file, err := os.Create(target)
      if err != nil {
        t.Fatal(err)
      }
      defer file.Close()
      if err := json.NewEncoder(file).Encode(records); err != nil {
        t.Fatal(err)
      }
      t.Logf("captured %d static Gin routes and %d dynamic plugin routes", len(routes), len(pluginRoutes))
    }
  GO

  begin
    File.write(test_path, go_test)
    env = {
      "GOWORK" => "off",
      "UAES_ROUTE_INVENTORY_OUTPUT" => output.path
    }
    stdout, stderr, status = Open3.capture3(env, "go", "test", "./router", "-run", "^TestUAESRouteInventory$", "-count=1", "-v", chdir: root)
    unless status.success?
      warn stdout
      warn stderr
      stop("runtime Gin route capture failed; route coverage is unknown")
    end
    puts stdout.lines.grep(/captured \d+ static Gin routes and \d+ dynamic plugin routes/)
    routes = JSON.parse(File.read(output.path))
  ensure
    File.delete(test_path) if File.exist?(test_path)
    output.unlink
  end
end

stop("runtime route inventory is empty") unless routes.is_a?(Array) && !routes.empty?
routes.each_with_index do |route, index|
  unless route.is_a?(Hash) && route["method"].is_a?(String) && route["path"].is_a?(String)
    stop("invalid route inventory entry at index #{index}")
  end
end

errors = []
covered = 0
documents.each do |relative|
  document = JSON.parse(File.read(File.join(root, relative)))
  (document["paths"] || {}).each do |path, path_item|
    (path_item || {}).each do |method, operation|
      next unless %w[get post put patch delete options head trace].include?(method)
      verb = method.upcase
      if operation_covered?(routes, verb, path)
        covered += 1
      else
        operation_id = operation.is_a?(Hash) ? operation["operationId"] : nil
        suffix = operation_id && !operation_id.empty? ? " (operationId=#{operation_id})" : ""
        errors << "#{relative}: documented operation has no matching runtime route: #{verb} #{path}#{suffix}"
      end
    end
  end
end

unless errors.empty?
  warn "ROUTER OPENAPI DRIFT: FAIL (#{errors.length} documented operations have no matching static Gin or built-in plugin route)"
  errors.each { |error| warn " - #{error}" }
  exit 1
end

puts "ROUTER OPENAPI DRIFT: PASS (#{covered} documented operations covered by #{routes.length} static Gin and built-in plugin routes)"
puts "ROUTER OPENAPI SCOPE: static Gin routes and the active built-in plugin generation are included; host protocol routes are included"
