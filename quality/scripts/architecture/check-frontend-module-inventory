#!/usr/bin/env ruby
require "set"
require "pathname"

def stop(message, code = 2)
  warn "FRONTEND MODULE INVENTORY: #{message}"
  exit code
end

root = ENV["UTER_REPO_ROOT"]
stop("UTER_REPO_ROOT is required") if root.nil? || root.empty?
root = File.expand_path(root)
src = File.join(root, "web/src")
stop("web/src directory missing") unless File.directory?(src)

EXTENSIONS = %w[.ts .tsx .js .jsx .mts .cts .mjs .cjs].freeze
SOURCE_GLOBS = %w[**/*.ts **/*.tsx **/*.js **/*.jsx **/*.mts **/*.cts **/*.mjs **/*.cjs].freeze
IMPORT_PATTERN = /(?<statement>\bimport\s+(?:type\s+)?(?:[^'";]*?\s+from\s+)?|\bexport\s+(?:type\s+)?[^'";]*?\s+from\s+|\bimport\s*\()\s*['"](?<specifier>[^'"]+)['"]/m

def test_source?(relative)
  relative.split("/").include?("__tests__") || File.basename(relative).match?(/\.(?:test|spec)\.[^.]+\z/)
end

def generated_source?(relative)
  relative == "routeTree.gen.ts" || File.basename(relative).match?(/\.(?:generated|gen)\.[^.]+\z/)
end


def import_kind(statement)
  return :dynamic if statement.match?(/\bimport\s*\(\s*\z/)

  return :type_only if statement.match?(/\b(?:import|export)\s+type\b/)

  named_clause = statement.match(/\b(?:import|export)\s+\{([^}]*)\}\s+from\s*\z/m)
  if named_clause
    specifiers = named_clause[1].split(",").map(&:strip)
    return :type_only if !specifiers.empty? && specifiers.all? { |item| item.match?(/\Atype\s+/) }
  end

  :runtime
end

def resolve_local(src, importer, specifier)
  candidate =
    if specifier.start_with?("@/")
      File.join(src, specifier.delete_prefix("@/"))
    elsif specifier.start_with?("./", "../")
      File.expand_path(specifier, File.dirname(importer))
    else
      return nil
    end

  candidates = [candidate]
  EXTENSIONS.each { |ext| candidates << candidate + ext }
  EXTENSIONS.each { |ext| candidates << File.join(candidate, "index#{ext}") }
  candidates.find { |path| File.file?(path) }
end

files = SOURCE_GLOBS.flat_map { |glob| Dir.glob(File.join(src, glob)) }.uniq.sort
stop("no frontend source files discovered") if files.empty?

production_edges = Hash.new(0)
production_samples = Hash.new { |hash, key| hash[key] = [] }
test_edges = Hash.new(0)
production_import_kinds = Hash.new(0)
test_import_kinds = Hash.new(0)
unresolved = []
generated_imports = 0
production_file_count = 0
test_file_count = 0
generated_file_count = 0

files.each do |file|
  relative_importer = file.delete_prefix(src + File::SEPARATOR)
  if generated_source?(relative_importer)
    generated_file_count += 1
    next
  end

  is_test = test_source?(relative_importer)
  is_test ? test_file_count += 1 : production_file_count += 1
  content = File.read(file)
  content.to_enum(:scan, IMPORT_PATTERN).each do
    match = Regexp.last_match
    specifier = match[:specifier]
    next unless specifier.start_with?("@/", "./", "../")
    kind = import_kind(match[:statement])
    (is_test ? test_import_kinds : production_import_kinds)[kind] += 1
    target = resolve_local(src, file, specifier)
    unless target
      unresolved << "#{relative_importer} -> #{specifier}"
      next
    end

    target_relative = target.delete_prefix(src + File::SEPARATOR)
    if generated_source?(target_relative)
      generated_imports += 1
      next
    end

    from = relative_importer.split("/").first
    to = if target.start_with?(src + File::SEPARATOR)
      target_relative.split("/").first
    elsif target == src
      "$src-root"
    else
      "$workspace/#{Pathname.new(target).relative_path_from(Pathname.new(src))}"
    end
    edge_key = [from, to]

    if is_test
      test_edges[edge_key] += 1
    else
      production_edges[edge_key] += 1
      if from != to && production_samples[edge_key].length < 64
        production_samples[edge_key] << "#{relative_importer} -> #{specifier} => #{target_relative}"
      end
    end
  end
end

unless unresolved.empty?
  warn "FRONTEND MODULE INVENTORY: unresolved local imports (#{unresolved.length})"
  unresolved.first(50).each { |item| warn " - #{item}" }
  stop("local import resolution incomplete")
end

puts "FRONTEND MODULE INVENTORY: PASS (#{files.length} source files; #{production_file_count} production, #{test_file_count} test, #{generated_file_count} generated)"
puts "FRONTEND MODULE PRODUCTION EDGES:"
production_edges.sort.each { |(from, to), count| puts "  #{from} -> #{to}: #{count}" }
puts "FRONTEND MODULE PRODUCTION EDGE SAMPLES:"
production_samples.sort.each do |(from, to), samples|
  puts "  #{from} -> #{to}:"
  samples.each { |sample| puts "    #{sample}" }
end
puts "FRONTEND MODULE TEST-ONLY EDGES:"
test_edges.sort.each { |(from, to), count| puts "  #{from} -> #{to}: #{count}" }
puts "FRONTEND MODULE PRODUCTION IMPORT KINDS:"
production_import_kinds.sort.each { |kind, count| puts "  #{kind}: #{count}" }
puts "FRONTEND MODULE TEST IMPORT KINDS:"
test_import_kinds.sort.each { |kind, count| puts "  #{kind}: #{count}" }
puts "FRONTEND MODULE GENERATED IMPORTS EXCLUDED: #{generated_imports}"
puts "FRONTEND MODULE BOUNDARIES: NOT_VERIFIED (inventory only; dependency policy requires review)"
