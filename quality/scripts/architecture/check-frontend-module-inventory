#!/usr/bin/env ruby
require "set"
require "pathname"

def stop(message, code = 2)
  warn "FRONTEND MODULE INVENTORY: #{message}"
  exit code
end

root = ENV["UTER_REPO_ROOT"]
stop("UTER_REPO_ROOT is required") if root.nil? || root.empty?
root = File.expand_path(root)
src = File.join(root, "web/src")
stop("web/src directory missing") unless File.directory?(src)

EXTENSIONS = %w[.ts .tsx .js .jsx .mts .cts .mjs .cjs].freeze
SOURCE_GLOBS = %w[**/*.ts **/*.tsx **/*.js **/*.jsx **/*.mts **/*.cts **/*.mjs **/*.cjs].freeze
IMPORT_PATTERN = /(?:\bimport\s+(?:type\s+)?(?:[^'";]*?\s+from\s+)?|\bexport\s+(?:type\s+)?[^'";]*?\s+from\s+|\bimport\s*\()\s*['"]([^'"]+)['"]/m

def resolve_local(src, importer, specifier)
  candidate =
    if specifier.start_with?("@/")
      File.join(src, specifier.delete_prefix("@/"))
    elsif specifier.start_with?("./", "../")
      File.expand_path(specifier, File.dirname(importer))
    else
      return nil
    end

  candidates = [candidate]
  EXTENSIONS.each { |ext| candidates << candidate + ext }
  EXTENSIONS.each { |ext| candidates << File.join(candidate, "index#{ext}") }
  candidates.find { |path| File.file?(path) }
end

files = SOURCE_GLOBS.flat_map { |glob| Dir.glob(File.join(src, glob)) }.uniq.sort
stop("no frontend source files discovered") if files.empty?

edges = Hash.new(0)
edge_samples = Hash.new { |hash, key| hash[key] = [] }
unresolved = []
files.each do |file|
  content = File.read(file)
  content.scan(IMPORT_PATTERN).flatten.each do |specifier|
    next unless specifier.start_with?("@/", "./", "../")
    target = resolve_local(src, file, specifier)
    unless target
      unresolved << "#{file.delete_prefix(src + File::SEPARATOR)} -> #{specifier}"
      next
    end

    from = file.delete_prefix(src + File::SEPARATOR).split("/").first
    if target.start_with?(src + File::SEPARATOR)
      relative_target = target.delete_prefix(src + File::SEPARATOR)
      to = relative_target.split("/").first
    elsif target == src
      to = "$src-root"
    else
      to = "$workspace/#{Pathname.new(target).relative_path_from(Pathname.new(src))}"
    end
    edge_key = [from, to]
    edges[edge_key] += 1
    if from != to && edge_samples[edge_key].length < 8
      importer_relative = file.delete_prefix(src + File::SEPARATOR)
      target_relative = target.start_with?(src + File::SEPARATOR) ? target.delete_prefix(src + File::SEPARATOR) : Pathname.new(target).relative_path_from(Pathname.new(src)).to_s
      edge_samples[edge_key] << "#{importer_relative} -> #{specifier} => #{target_relative}"
    end
  end
end

unless unresolved.empty?
  warn "FRONTEND MODULE INVENTORY: unresolved local imports (#{unresolved.length})"
  unresolved.first(50).each { |item| warn " - #{item}" }
  stop("local import resolution incomplete")
end

puts "FRONTEND MODULE INVENTORY: PASS (#{files.length} source files; all alias/relative imports resolved)"
puts "FRONTEND MODULE EDGES:"
edges.sort.each { |(from, to), count| puts "  #{from} -> #{to}: #{count}" }
puts "FRONTEND MODULE EDGE SAMPLES:"
edge_samples.sort.each do |(from, to), samples|
  puts "  #{from} -> #{to}:"
  samples.each { |sample| puts "    #{sample}" }
end
puts "FRONTEND MODULE BOUNDARIES: NOT_VERIFIED (inventory only; dependency policy requires review)"
